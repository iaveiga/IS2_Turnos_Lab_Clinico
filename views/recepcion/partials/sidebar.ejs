<aside class="navbar navbar-vertical navbar-expand-lg admin-navbar reception-navbar" data-bs-theme="dark">
    <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#reception-sidebar-menu" aria-controls="reception-sidebar-menu" aria-expanded="false" aria-label="Abrir navegación">
            <span class="navbar-toggler-icon"></span>
        </button>
        <h1 class="navbar-brand navbar-brand-autodark">
            <a href="/recepcion" class="admin-brand-link">
                <span class="admin-brand-mark">CSF</span>
                <span class="admin-brand-copy"><strong>Clínica San Francisco</strong><small>Recepción</small></span>
            </a>
        </h1>
        <div class="collapse navbar-collapse" id="reception-sidebar-menu">
            <ul class="navbar-nav pt-lg-3">
                <li class="nav-item active">
                    <a class="nav-link" href="/recepcion"><span class="nav-link-icon"><i data-lucide="clipboard-check"></i></span><span class="nav-link-title">Control de recepción</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#turnos-dia"><span class="nav-link-icon"><i data-lucide="calendar-days"></i></span><span class="nav-link-title">Turnos del día</span></a>
                </li>
                <% if ((locals.permisosUsuario || []).includes('ACCEDER_CONSOLA')) { %>
                    <li class="nav-item mt-lg-3">
                        <a class="nav-link" href="/admin"><span class="nav-link-icon"><i data-lucide="shield-check"></i></span><span class="nav-link-title">Administración</span></a>
                    </li>
                <% } %>
            </ul>
            <div class="admin-sidebar-user mt-auto">
                <span class="avatar avatar-sm reception-profile-avatar"><%= locals.usuario.nombre.split(' ').map((parte) => parte[0]).slice(0, 2).join('').toUpperCase() %></span>
                <span class="admin-sidebar-user-copy"><strong><%= locals.usuario.nombre %></strong><small><%= String(locals.usuario.rol || 'Recepción').replaceAll('_', ' ') %></small></span>
                <a class="btn btn-icon btn-ghost-light btn-sm" href="/auth/logout" aria-label="Cerrar sesión" title="Cerrar sesión"><i data-lucide="log-out"></i></a>
            </div>
        </div>
    </div>
</aside>
