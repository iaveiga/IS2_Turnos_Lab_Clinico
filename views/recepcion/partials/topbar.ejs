<header class="navbar navbar-expand-md d-none d-lg-flex d-print-none admin-topbar">
    <div class="container-xl">
        <div class="navbar-nav flex-row order-md-last">
            <div class="nav-item dropdown">
                <a href="#" class="nav-link d-flex lh-1 p-0" data-bs-toggle="dropdown" aria-label="Abrir menú de usuario">
                    <span class="avatar avatar-sm reception-profile-avatar"><%= locals.usuario.nombre.split(' ').map((parte) => parte[0]).slice(0, 2).join('').toUpperCase() %></span>
                    <div class="d-none d-xl-block ps-2"><div class="admin-topbar-name"><%= locals.usuario.nombre %></div><div class="mt-1 small text-secondary"><%= locals.usuario.identificacion || 'Recepción' %></div></div>
                </a>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                    <% if ((locals.permisosUsuario || []).includes('ACCEDER_CONSOLA')) { %><a href="/admin" class="dropdown-item"><i data-lucide="shield-check"></i><span>Administración</span></a><% } %>
                    <a href="/auth/logout" class="dropdown-item"><i data-lucide="log-out"></i><span>Cerrar sesión</span></a>
                </div>
            </div>
        </div>
        <div class="admin-context"><i data-lucide="clipboard-check"></i><span>Recepción y admisión</span></div>
    </div>
</header>
