<%- include('../partials/head', {
    titulo: 'Mis turnos',
    descripcion: 'Consulta y agenda tus turnos de laboratorio.'
}) %>
<% const puedeCrearTurno = (locals.permisosUsuario || locals.usuario?.permisos || []).includes('CREAR_TURNO'); %>
<body class="patient-page">
    <%- include('../partials/public-header', { seccion: 'turnos' }) %>

    <main class="container-xl patient-main">
        <% if (turnoCreado) { %>
            <div class="alert alert-success alert-dismissible booking-success" role="status">
                <div class="d-flex">
                    <div class="alert-icon"><i data-lucide="circle-check"></i></div>
                    <div><strong>Turno agendado correctamente.</strong> Tu código de reserva es <strong><%= turnoCreado %></strong>.</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        <% } %>

        <header class="module-header">
            <div>
                <p class="app-eyebrow">Portal de pacientes</p>
                <h1>Mis turnos de laboratorio</h1>
                <p>Consulta tus citas, revisa tus resultados y reserva un horario disponible para tus exámenes.</p>
            </div>
            <% if (puedeCrearTurno) { %>
                <button class="btn btn-primary" type="button" data-open-booking <%= !paciente || !hayServiciosDisponibles ? 'disabled' : '' %>>
                    <i data-lucide="calendar-plus"></i>Agendar turno
                </button>
            <% } %>
        </header>

        <% if (!paciente) { %>
            <div class="alert alert-warning" role="alert">
                <div class="d-flex"><div class="alert-icon"><i data-lucide="circle-alert"></i></div><div><strong>No hay un paciente asociado a tu usuario.</strong><div class="text-secondary mt-1">Solicita al administrador que complete la relación antes de agendar.</div></div></div>
            </div>
        <% } else if (!hayServiciosDisponibles) { %>
            <div class="alert alert-warning" role="alert">
                <div class="d-flex"><div class="alert-icon"><i data-lucide="calendar-x"></i></div><div><strong>Aún no hay horarios disponibles.</strong><div class="text-secondary mt-1">Los tipos de examen necesitan al menos un horario activo en la base de datos.</div></div></div>
            </div>
        <% } %>

        <section class="card appointments-card" aria-labelledby="appointments-title">
            <div class="card-header">
                <div>
                    <h2 class="card-title" id="appointments-title">Citas y reservas</h2>
                    <div class="text-secondary small mt-1"><%= turnos.length %> <%= turnos.length === 1 ? 'turno sin atender' : 'turnos sin atender' %></div>
                </div>
            </div>

            <% if (turnos.length === 0) { %>
                <div class="appointments-empty">
                    <span class="avatar bg-azure-lt text-azure"><i data-lucide="calendar-days"></i></span>
                    <h3>No tienes citas pendientes</h3>
                    <p>Elige un tipo de examen, una fecha y uno de los horarios con cupo.</p>
                    <% if (puedeCrearTurno && paciente && hayServiciosDisponibles) { %>
                        <button class="btn btn-primary" type="button" data-open-booking><i data-lucide="plus"></i>Agendar mi primer turno</button>
                    <% } %>
                </div>
            <% } else { %>
                <div>
                    <% turnos.forEach((turno) => { %>
                        <% const estadoClase = turno.estadoCodigo === 'atendido' ? 'bg-green-lt' : turno.estadoCodigo === 'cancelado' || turno.estadoCodigo === 'ausente' ? 'bg-red-lt' : 'bg-azure-lt'; %>
                        <article class="appointment-row">
                            <div class="appointment-date"><span><%= turno.fecha %></span><strong><%= turno.hora %></strong></div>
                            <div class="appointment-info">
                                <span class="avatar avatar-sm bg-cyan-lt text-cyan"><i data-lucide="flask-conical"></i></span>
                                <div class="min-w-0">
                                    <h3><%= turno.servicio %></h3>
                                    <p><%= turno.codigo %><% if (turno.observacion) { %> · <%= turno.observacion %><% } %></p>
                                </div>
                            </div>
                            <span class="badge <%= estadoClase %>"><%= turno.estado %></span>
                        </article>
                    <% }); %>
                </div>
            <% } %>
        </section>

        <section class="card appointments-card exam-history-card" aria-labelledby="exam-history-title">
            <div class="card-header">
                <div>
                    <h2 class="card-title" id="exam-history-title">Historial de exámenes</h2>
                    <div class="text-secondary small mt-1"><%= historial.length %> <%= historial.length === 1 ? 'servicio atendido' : 'servicios atendidos' %></div>
                </div>
            </div>

            <% if (historial.length === 0) { %>
                <div class="appointments-empty exam-history-empty">
                    <span class="avatar bg-teal-lt text-teal"><i data-lucide="clipboard-check"></i></span>
                    <h3>Aún no tienes exámenes atendidos</h3>
                    <p>Cuando finalice una atención, podrás consultar aquí el examen y su resultado publicado.</p>
                </div>
            <% } else { %>
                <div class="exam-history-list">
                    <% historial.forEach((turno) => { %>
                        <article class="exam-history-row">
                            <div class="appointment-date"><span><%= turno.fecha %></span><strong><%= turno.hora %></strong></div>
                            <div class="appointment-info">
                                <span class="avatar avatar-sm bg-teal-lt text-teal"><i data-lucide="microscope"></i></span>
                                <div class="min-w-0">
                                    <h3><%= turno.servicio %></h3>
                                    <p><%= turno.codigo %> · <%= turno.servicioDescripcion %></p>
                                </div>
                            </div>
                            <div class="exam-result-state">
                                <% if (turno.resultado) { %>
                                    <span class="badge bg-green-lt"><i data-lucide="circle-check"></i>Publicado</span>
                                    <small><%= turno.resultado.fechaPublicacion %></small>
                                <% } else { %>
                                    <span class="badge bg-yellow-lt"><i data-lucide="clock-3"></i>Pendiente</span>
                                    <small>En proceso de publicación</small>
                                <% } %>
                            </div>
                            <% if (turno.resultado) { %>
                                <button class="btn btn-outline-primary btn-sm exam-result-action" type="button" data-view-result="<%= turno.id %>">
                                    <i data-lucide="file-search"></i>Ver resultado
                                </button>
                            <% } else { %>
                                <button class="btn btn-outline-secondary btn-sm exam-result-action" type="button" disabled>
                                    <i data-lucide="file-clock"></i>No disponible
                                </button>
                            <% } %>
                        </article>
                    <% }); %>
                </div>
            <% } %>
        </section>
    </main>

    <% if (puedeCrearTurno) { %>
    <div class="modal modal-blur fade booking-modal" id="booking-modal" tabindex="-1" aria-hidden="true" data-auto-open="<%= abrirModal && paciente && hayServiciosDisponibles ? 'true' : 'false' %>">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <form class="modal-content" id="booking-form" novalidate>
                <div class="modal-header">
                    <div class="booking-modal-title">
                        <span class="avatar bg-cyan-lt text-cyan"><i data-lucide="calendar-plus"></i></span>
                        <div><p class="app-eyebrow">Nueva reserva</p><h2>Agenda tu turno</h2></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <div class="patient-summary">
                        <span class="avatar bg-white text-cyan"><i data-lucide="user-round"></i></span>
                        <div class="patient-summary-copy">
                            <small>Paciente</small>
                            <strong><%= paciente ? paciente.nombres + ' ' + paciente.apellidos : 'Sin paciente asociado' %></strong>
                            <% if (paciente) { %><small>CI <%= paciente.identificacion %></small><% } %>
                        </div>
                    </div>

                    <fieldset class="booking-section">
                        <legend><span class="booking-step">1</span>Tipo de examen</legend>
                        <div class="exam-options">
                            <% servicios.forEach((servicio) => { %>
                                <label class="exam-option <%= servicio.disponible ? '' : 'exam-option-disabled' %>" <%= servicio.disponible ? '' : 'aria-disabled="true"' %>>
                                    <input type="radio" name="id_servicio" value="<%= servicio.id_servicio %>" required <%= servicio.disponible ? '' : 'disabled' %>>
                                    <span class="exam-option-content">
                                        <span class="exam-icon"><i data-lucide="<%= servicio.icono %>"></i></span>
                                        <span class="exam-copy"><strong><%= servicio.nombre %></strong><small><%= servicio.descripcion || 'Examen de laboratorio' %></small></span>
                                        <span class="option-status">
                                            <i data-lucide="<%= servicio.disponible ? 'circle-check' : 'circle-slash-2' %>"></i>
                                            <% if (!servicio.disponible) { %><small>No disponible</small><% } %>
                                        </span>
                                    </span>
                                </label>
                            <% }); %>
                        </div>
                    </fieldset>

                    <fieldset class="booking-section">
                        <legend><span class="booking-step">2</span>Fecha y hora</legend>
                        <div class="schedule-grid">
                            <div>
                                <label class="form-label" for="appointment-date">Fecha de atención</label>
                                <input id="appointment-date" class="form-control" type="date" name="fecha_turno" min="<%= fechaMinima %>" max="<%= fechaMaxima %>" required>
                            </div>
                            <div class="slots-field">
                                <div class="slots-heading"><span>Horarios disponibles</span><small>Hora local de Guayaquil</small></div>
                                <div id="slots-state" class="slots-state"><i data-lucide="mouse-pointer-click"></i><span>Selecciona un examen y una fecha.</span></div>
                                <div id="time-slots" class="time-slots" aria-live="polite"></div>
                            </div>
                        </div>
                        <input type="hidden" name="id_horario">
                        <input type="hidden" name="hora_inicio">
                    </fieldset>

                    <div class="booking-notes">
                        <label class="form-label" for="appointment-notes">Observación <span class="text-secondary fw-normal">(opcional)</span></label>
                        <textarea id="appointment-notes" class="form-control" name="observacion" rows="2" maxlength="500" placeholder="Indica alguna consideración para el laboratorio"></textarea>
                    </div>
                    <div id="booking-error" class="alert alert-danger mt-3 mb-0" role="alert" hidden></div>
                </div>

                <div class="modal-footer">
                    <p class="booking-validation-note"><i data-lucide="shield-check"></i>Tu cupo se valida nuevamente al confirmar.</p>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled><i data-lucide="check"></i>Confirmar turno</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <% } %>

    <div class="modal modal-blur fade patient-result-modal" id="patient-result-modal" tabindex="-1" aria-hidden="true" aria-labelledby="patient-result-title">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="patient-result-heading">
                        <span class="avatar bg-teal-lt text-teal"><i data-lucide="file-check-2"></i></span>
                        <div>
                            <p class="app-eyebrow">Resultado publicado</p>
                            <h2 class="modal-title" id="patient-result-title">Resultado del examen</h2>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="patient-result-summary">
                        <div><span>Servicio</span><strong data-result-service></strong></div>
                        <div><span>Turno</span><strong data-result-code></strong></div>
                        <div><span>Fecha de atención</span><strong data-result-date></strong></div>
                    </div>
                    <section class="patient-result-section" aria-labelledby="result-detail-title">
                        <h3 id="result-detail-title">Detalle del resultado</h3>
                        <div class="patient-result-text" data-result-text></div>
                    </section>
                    <section class="patient-result-section" data-result-observations-section aria-labelledby="result-observations-title">
                        <h3 id="result-observations-title">Observaciones</h3>
                        <div class="patient-result-text" data-result-observations></div>
                    </section>
                    <div class="patient-result-meta">
                        <span><i data-lucide="user-round-check"></i><span data-result-technician></span></span>
                        <span><i data-lucide="calendar-check-2"></i><span data-result-published></span></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-primary" data-print-result><i data-lucide="printer"></i>Imprimir resultado</button>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <article class="patient-result-print" aria-label="Informe imprimible de resultado de laboratorio">
        <header class="patient-result-print-header">
            <div class="patient-result-print-brand">
                <span class="patient-result-print-logo">CSF</span>
                <div>
                    <strong>Clínica San Francisco</strong>
                    <span>Laboratorio clínico</span>
                </div>
            </div>
            <div class="patient-result-print-title">
                <strong>Informe de resultados</strong>
                <span data-print-code></span>
            </div>
        </header>

        <div class="patient-result-print-meta">
            <span>Fecha de impresión</span>
            <strong data-print-date></strong>
        </div>

        <section class="patient-result-print-section">
            <h2>Información del paciente</h2>
            <dl class="patient-result-print-grid">
                <div><dt>Paciente</dt><dd data-print-patient></dd></div>
                <div><dt>Identificación</dt><dd data-print-identification></dd></div>
                <div><dt>Edad</dt><dd data-print-age></dd></div>
                <div><dt>Sexo</dt><dd data-print-sex></dd></div>
            </dl>
        </section>

        <section class="patient-result-print-section">
            <h2>Información del servicio</h2>
            <dl class="patient-result-print-grid">
                <div><dt>Servicio o examen</dt><dd data-print-service></dd></div>
                <div><dt>Fecha del servicio</dt><dd data-print-service-date></dd></div>
            </dl>
        </section>

        <section class="patient-result-print-section">
            <h2>Resultado</h2>
            <div class="patient-result-print-content" data-print-result-text></div>
        </section>

        <section class="patient-result-print-section">
            <h2>Comentarios u observaciones</h2>
            <div class="patient-result-print-content" data-print-observations></div>
        </section>

        <footer class="patient-result-print-footer">
            <div><span>Responsable del resultado</span><strong data-print-technician></strong></div>
            <div><span>Fecha de publicación</span><strong data-print-published></strong></div>
        </footer>
    </article>
    <script id="patient-results-data" type="application/json"><%- resultadosJson %></script>

    <%- include('../partials/footer') %>
    <%- include('../partials/scripts', { scripts: ['/js/turnos.js'] }) %>
</body>
</html>
