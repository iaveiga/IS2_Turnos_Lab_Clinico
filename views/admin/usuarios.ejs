<%- include('../partials/head', {
    titulo: 'Gestión de usuarios',
    descripcion: 'Administración de usuarios del Laboratorio Clínico San Francisco',
    estilos: ['/css/admin-tabler.css']
}) %>
<body class="layout-fluid admin-tabler-page">
    <div class="page">
        <%- include('partials/sidebar', { seccionAdmin: 'usuarios' }) %>

        <div class="page-wrapper">
            <%- include('partials/topbar') %>

            <div class="page-header d-print-none">
                <div class="container-xl">
                    <div class="row g-2 align-items-center">
                        <div class="col">
                            <div class="page-pretitle">Administración del sistema</div>
                            <h2 class="page-title">Usuarios administrativos</h2>
                            <div class="text-secondary mt-1">Administra las cuentas y los roles del personal del laboratorio.</div>
                        </div>
                        <div class="col-auto ms-auto d-print-none">
                            <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#create-user-modal">
                                <i data-lucide="user-plus"></i>
                                <span>Nuevo usuario</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="page-body">
                <div class="container-xl">
                    <%- include('partials/alerts') %>

                    <section class="card admin-users-card" aria-labelledby="users-table-title">
                        <form class="card-body border-bottom admin-filter-form" method="get" action="/admin/usuarios" data-auto-submit-filters>
                            <div class="row g-2 align-items-end">
                                <div class="col-12 col-lg">
                                    <label class="form-label visually-hidden" for="user-search">Buscar usuarios</label>
                                    <div class="input-icon">
                                        <span class="input-icon-addon"><i data-lucide="search"></i></span>
                                        <input
                                            id="user-search"
                                            class="form-control"
                                            type="search"
                                            name="buscar"
                                            value="<%= filtros.buscar %>"
                                            placeholder="Buscar nombre, cédula o correo"
                                        >
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <label class="form-label" for="role-filter">Rol</label>
                                    <select id="role-filter" class="form-select" name="rol">
                                        <option value="">Todos</option>
                                        <% rolesPersonal.forEach((rol) => { %>
                                            <option value="<%= rol.id_rol %>" <%= String(filtros.rol) === String(rol.id_rol) ? 'selected' : '' %>><%= rol.nombre %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <label class="form-label" for="status-filter">Estado</label>
                                    <select id="status-filter" class="form-select" name="estado">
                                        <option value="">Todos</option>
                                        <option value="activo" <%= filtros.estado === 'activo' ? 'selected' : '' %>>Activo</option>
                                        <option value="inactivo" <%= filtros.estado === 'inactivo' ? 'selected' : '' %>>Inactivo</option>
                                    </select>
                                </div>
                                <div class="col-8 col-md-auto">
                                    <button class="btn btn-outline-secondary w-100" type="submit">
                                        <i data-lucide="list-filter"></i>
                                        Filtrar
                                    </button>
                                </div>
                                <% if (filtros.buscar || filtros.rol || filtros.estado) { %>
                                    <div class="col-4 col-md-auto">
                                        <a class="btn btn-icon btn-outline-secondary w-100" href="/admin/usuarios" title="Limpiar filtros" aria-label="Limpiar filtros">
                                            <i data-lucide="filter-x"></i>
                                        </a>
                                    </div>
                                <% } %>
                            </div>
                        </form>

                        <div class="table-responsive">
                            <table class="table table-vcenter table-hover card-table admin-users-table">
                                <thead>
                                    <tr>
                                        <th id="users-table-title">Usuario administrativo</th>
                                        <th>Identificación</th>
                                        <th>Rol</th>
                                        <th>Correo</th>
                                        <th>Estado</th>
                                        <th class="w-1"><span class="visually-hidden">Acciones</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (usuarios.length === 0) { %>
                                        <tr>
                                            <td colspan="6">
                                                <div class="empty py-5">
                                                    <div class="empty-icon"><i data-lucide="user-search"></i></div>
                                                    <p class="empty-title">No se encontraron usuarios</p>
                                                    <p class="empty-subtitle text-secondary">Revisa los criterios de búsqueda seleccionados.</p>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                    <% usuarios.forEach((usuario) => { %>
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-3 admin-user-cell">
                                                    <span class="avatar avatar-sm bg-primary-lt text-primary"><%= usuario.nombre.split(' ').map((parte) => parte[0]).slice(0, 2).join('').toUpperCase() %></span>
                                                    <div class="min-w-0">
                                                        <div class="fw-semibold text-body text-truncate"><%= usuario.nombre %></div>
                                                        <div class="small text-secondary text-truncate"><%= usuario.ultimoAcceso %></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="text-secondary text-nowrap"><%= usuario.identificacion %></span></td>
                                            <td><span class="badge bg-azure-lt"><%= usuario.rol %></span></td>
                                            <td><span class="admin-user-email"><%= usuario.correo %></span></td>
                                            <td>
                                                <span class="badge <%= usuario.activo ? 'bg-green-lt' : 'bg-red-lt' %>">
                                                    <span class="status-dot <%= usuario.activo ? 'status-dot-animated bg-green' : 'bg-red' %> me-1"></span>
                                                    <%= usuario.activo ? 'Activo' : 'Inactivo' %>
                                                </span>
                                            </td>
                                            <td>
                                                <div class="dropdown">
                                                    <button class="btn btn-icon btn-ghost-secondary btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Acciones de <%= usuario.nombre %>">
                                                        <i data-lucide="ellipsis-vertical"></i>
                                                    </button>
                                                    <div class="dropdown-menu dropdown-menu-end">
                                                        <button
                                                            class="dropdown-item"
                                                            type="button"
                                                            data-edit-user
                                                            data-id="<%= usuario.id %>"
                                                            data-first-name="<%= usuario.nombres %>"
                                                            data-last-name="<%= usuario.apellidos %>"
                                                            data-identification="<%= usuario.identificacion %>"
                                                            data-email="<%= usuario.correo %>"
                                                            data-role="<%= usuario.idRol %>"
                                                        >
                                                            <i data-lucide="pencil"></i><span>Editar</span>
                                                        </button>
                                                        <% if (!usuario.esActual) { %>
                                                            <form method="post" action="/admin/usuarios/<%= usuario.id %>/estado">
                                                                <input type="hidden" name="activo" value="<%= usuario.activo ? 'false' : 'true' %>">
                                                                <button type="submit" class="dropdown-item <%= usuario.activo ? 'text-danger' : 'text-success' %>">
                                                                    <i data-lucide="<%= usuario.activo ? 'user-x' : 'user-check' %>"></i>
                                                                    <span><%= usuario.activo ? 'Desactivar' : 'Activar' %></span>
                                                                </button>
                                                            </form>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <div class="card-footer d-flex align-items-center admin-table-footer">
                            <p class="m-0 text-secondary">Mostrando <%= paginacion.desde %>–<%= paginacion.hasta %> de <%= paginacion.total %> usuarios administrativos</p>
                            <ul class="pagination m-0 ms-auto">
                                <% const queryBase = 'buscar=' + encodeURIComponent(filtros.buscar) + '&rol=' + encodeURIComponent(filtros.rol) + '&estado=' + encodeURIComponent(filtros.estado); %>
                                <li class="page-item <%= paginacion.pagina === 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="/admin/usuarios?<%= queryBase %>&pagina=<%= Math.max(paginacion.pagina - 1, 1) %>" aria-label="Página anterior">
                                        <i data-lucide="chevron-left"></i>
                                    </a>
                                </li>
                                <% for (let numero = 1; numero <= paginacion.totalPaginas; numero += 1) { %>
                                    <li class="page-item <%= numero === paginacion.pagina ? 'active' : '' %>">
                                        <a class="page-link" href="/admin/usuarios?<%= queryBase %>&pagina=<%= numero %>"><%= numero %></a>
                                    </li>
                                <% } %>
                                <li class="page-item <%= paginacion.pagina === paginacion.totalPaginas ? 'disabled' : '' %>">
                                    <a class="page-link" href="/admin/usuarios?<%= queryBase %>&pagina=<%= Math.min(paginacion.pagina + 1, paginacion.totalPaginas) %>" aria-label="Página siguiente">
                                        <i data-lucide="chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/user-modals') %>

    <%- include('../partials/scripts', { scripts: ['/js/admin-users.js'] }) %>
</body>
</html>
