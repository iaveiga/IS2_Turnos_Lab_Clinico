<%- include('../partials/head', {
    titulo: 'Reportes',
    descripcion: 'Reportes administrativos del Laboratorio Clínico San Francisco',
    estilos: ['/css/admin-tabler.css']
}) %>
<body class="layout-fluid admin-tabler-page">
    <div class="page">
        <%- include('partials/sidebar', { seccionAdmin: 'reportes' }) %>

        <div class="page-wrapper">
            <%- include('partials/topbar') %>

            <div class="page-header d-print-none">
                <div class="container-xl">
                    <div class="row g-2 align-items-center">
                        <div class="col">
                            <div class="page-pretitle">Administración del sistema</div>
                            <h2 class="page-title">Reportes</h2>
                            <div class="text-secondary mt-1">Indicadores de usuarios y servicios atendidos por rango de fecha.</div>
                        </div>
                        <div class="col-auto ms-auto d-print-none">
                            <button class="btn btn-outline-secondary" type="button" data-print-report><i data-lucide="printer"></i>Imprimir</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="page-body">
                <div class="container-xl">
                    <% if (errorReporte) { %>
                        <div class="alert alert-warning" role="alert">
                            <div class="alert-icon"><i data-lucide="triangle-alert"></i></div>
                            <div><%= errorReporte %></div>
                        </div>
                    <% } %>

                    <form class="card admin-report-filter mb-3 d-print-none" method="get" action="/admin/reportes" data-report-filters>
                        <div class="card-body">
                            <div class="row g-2 align-items-end">
                                <div class="col-12 col-md-4 col-xl-3">
                                    <label class="form-label" for="report-period">Periodo</label>
                                    <select id="report-period" class="form-select" name="periodo">
                                        <option value="semana_anterior" <%= filtros.periodo === 'semana_anterior' ? 'selected' : '' %>>Semana anterior</option>
                                        <option value="dia_anterior" <%= filtros.periodo === 'dia_anterior' ? 'selected' : '' %>>Día anterior</option>
                                        <option value="mes_anterior" <%= filtros.periodo === 'mes_anterior' ? 'selected' : '' %>>Mes anterior</option>
                                        <option value="personalizado" <%= filtros.periodo === 'personalizado' ? 'selected' : '' %>>Personalizado</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-6 col-xl-4 admin-report-date-group">
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label class="form-label" for="report-start">Fecha inicio</label>
                                            <input id="report-start" class="form-control" type="date" name="desde" value="<%= filtros.desde %>" max="<%= fechaMaxima %>">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label" for="report-end">Fecha fin</label>
                                            <input id="report-end" class="form-control" type="date" name="hasta" value="<%= filtros.hasta %>" max="<%= fechaMaxima %>">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-auto">
                                    <button class="btn btn-primary w-100" type="submit"><i data-lucide="bar-chart-3"></i>Generar</button>
                                </div>
                            </div>
                        </div>
                    </form>

                    <section class="admin-report-summary" aria-label="Resumen del periodo">
                        <article class="card admin-report-metric">
                            <div class="card-body">
                                <span class="avatar bg-cyan-lt text-cyan"><i data-lucide="users-round"></i></span>
                                <div>
                                    <strong><%= resumen.pacientes %></strong>
                                    <span>Usuarios atendidos</span>
                                </div>
                            </div>
                        </article>
                        <article class="card admin-report-metric">
                            <div class="card-body">
                                <span class="avatar bg-green-lt text-green"><i data-lucide="calendar-check"></i></span>
                                <div>
                                    <strong><%= resumen.turnos %></strong>
                                    <span>Turnos atendidos</span>
                                </div>
                            </div>
                        </article>
                        <article class="card admin-report-metric">
                            <div class="card-body">
                                <span class="avatar bg-purple-lt text-purple"><i data-lucide="flask-conical"></i></span>
                                <div>
                                    <strong><%= resumen.servicios %></strong>
                                    <span>Servicios solicitados</span>
                                </div>
                            </div>
                        </article>
                    </section>

                    <section class="admin-report-section" aria-labelledby="service-users-title">
                        <div class="admin-report-heading">
                            <div>
                                <h3 id="service-users-title">Número de usuarios atendidos por servicio</h3>
                                <p><%= filtros.desde %> a <%= filtros.hasta %></p>
                            </div>
                        </div>
                        <% if (usuariosPorServicio.length === 0) { %>
                            <div class="empty admin-report-empty">
                                <div class="empty-icon"><i data-lucide="file-search"></i></div>
                                <p class="empty-title">No hay usuarios atendidos en este rango</p>
                                <p class="empty-subtitle text-secondary">Selecciona otro periodo para consultar actividad registrada.</p>
                            </div>
                        <% } else { %>
                            <div class="admin-report-card-grid">
                                <% usuariosPorServicio.forEach((item) => { %>
                                    <article class="card admin-report-card">
                                        <div class="card-body">
                                            <div class="admin-report-card-top">
                                                <span class="avatar bg-cyan-lt text-cyan"><i data-lucide="flask-conical"></i></span>
                                                <span class="badge bg-azure-lt"><%= item.porcentaje %>%</span>
                                            </div>
                                            <h4 title="<%= item.servicio %>"><%= item.servicio %></h4>
                                            <strong><%= item.pacientes %></strong>
                                            <span><%= item.turnos %> turnos atendidos</span>
                                            <div class="progress progress-sm mt-3">
                                                <div class="progress-bar bg-cyan" style="width: <%= item.porcentaje %>%"></div>
                                            </div>
                                        </div>
                                    </article>
                                <% }); %>
                            </div>
                        <% } %>
                    </section>

                    <section class="admin-report-section" aria-labelledby="gender-service-title">
                        <div class="admin-report-heading">
                            <div>
                                <h3 id="gender-service-title">Pacientes atendidos por género y servicio</h3>
                                <p><%= filtros.desde %> a <%= filtros.hasta %></p>
                            </div>
                        </div>
                        <% if (usuariosPorGeneroServicio.length === 0) { %>
                            <div class="empty admin-report-empty">
                                <div class="empty-icon"><i data-lucide="users-round"></i></div>
                                <p class="empty-title">No hay usuarios para listar</p>
                                <p class="empty-subtitle text-secondary">El cruce por género y servicio aparecerá cuando existan atenciones.</p>
                            </div>
                        <% } else { %>
                            <div class="admin-report-card-grid admin-report-card-grid-wide">
                                <% usuariosPorGeneroServicio.forEach((item) => { %>
                                    <article class="card admin-report-card admin-report-gender-card">
                                        <div class="card-body">
                                            <div class="admin-report-card-top">
                                                <span class="avatar bg-purple-lt text-purple"><i data-lucide="users-round"></i></span>
                                                <span class="badge bg-cyan-lt"><%= item.pacientes %> <%= item.pacientes === 1 ? 'paciente' : 'pacientes' %></span>
                                            </div>
                                            <h4 title="<%= item.servicio %>"><%= item.servicio %></h4>
                                            <div class="admin-report-gender-list">
                                                <% item.generos.forEach((genero) => { %>
                                                    <% const generoColor = genero.genero === 'Masculino' ? 'bg-azure' : genero.genero === 'Femenino' ? 'bg-purple' : 'bg-secondary'; %>
                                                    <div class="admin-report-gender-row">
                                                        <div class="admin-report-gender-count">
                                                            <span><i data-lucide="user-round"></i><%= genero.genero %></span>
                                                            <strong><%= genero.pacientes %> <small><%= genero.pacientes === 1 ? 'paciente' : 'pacientes' %></small></strong>
                                                        </div>
                                                        <div class="progress progress-sm">
                                                            <div class="progress-bar <%= generoColor %>" style="width: <%= genero.porcentaje %>%"></div>
                                                        </div>
                                                    </div>
                                                <% }); %>
                                            </div>
                                        </div>
                                    </article>
                                <% }); %>
                            </div>
                        <% } %>
                    </section>

                    <section class="admin-report-section" aria-labelledby="service-detail-title">
                        <div class="admin-report-heading">
                            <div>
                                <h3 id="service-detail-title">Detalle de servicios atendidos por rango de fecha</h3>
                                <p><%= filtros.desde %> a <%= filtros.hasta %></p>
                            </div>
                        </div>
                        <% if (detalleServicios.length === 0) { %>
                            <div class="empty admin-report-empty">
                                <div class="empty-icon"><i data-lucide="calendar-x-2"></i></div>
                                <p class="empty-title">No hay servicios atendidos</p>
                                <p class="empty-subtitle text-secondary">Cambia el rango para revisar atenciones anteriores.</p>
                            </div>
                        <% } else { %>
                            <div class="admin-report-card-grid admin-report-card-grid-wide">
                                <% detalleServicios.forEach((dia) => { %>
                                    <article class="card admin-report-detail-card admin-report-date-card">
                                        <div class="card-body">
                                            <div class="admin-report-card-top">
                                                <span class="avatar bg-green-lt text-green"><i data-lucide="calendar-check-2"></i></span>
                                                <span class="badge bg-green-lt"><i data-lucide="circle-check"></i>Atendido</span>
                                            </div>
                                            <div class="admin-report-date-summary">
                                                <div>
                                                    <span>Fecha de atención</span>
                                                    <h4 title="<%= dia.fecha %>"><%= dia.fecha %></h4>
                                                </div>
                                                <div class="admin-report-date-total">
                                                    <strong><%= dia.serviciosAtendidos %></strong>
                                                    <span><%= dia.serviciosAtendidos === 1 ? 'servicio atendido' : 'servicios atendidos' %></span>
                                                </div>
                                            </div>
                                        </div>
                                    </article>
                                <% }); %>
                            </div>
                        <% } %>
                    </section>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/scripts', { scripts: ['/js/admin-reports.js'] }) %>
</body>
</html>
