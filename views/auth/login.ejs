<%- include('../partials/head', {
    titulo: 'Iniciar sesión',
    descripcion: 'Acceso de pacientes y personal al portal del laboratorio.'
}) %>
<body class="auth-page">
    <main class="auth-layout">
        <section class="auth-visual" aria-label="Clínica San Francisco">
            <a class="auth-brand" href="/" aria-label="Ir al inicio">
                <span class="app-brand-mark">CSF</span>
                <span class="app-brand-copy">
                    <strong>Clínica San Francisco</strong>
                    <small>Laboratorio clínico</small>
                </span>
            </a>
            <div class="auth-message">
                <h1>Tu salud, en tiempo real.</h1>
                <p>Accede a tus turnos de laboratorio y gestiona tu atención de forma rápida y segura.</p>
            </div>
            <p class="auth-security"><i data-lucide="shield-check"></i>Portal seguro para pacientes y personal</p>
        </section>

        <section class="auth-form-panel">
            <div class="auth-shell auth-shell-login">
                <header class="auth-heading">
                    <p class="app-eyebrow">Acceso al sistema</p>
                    <h1>Iniciar sesión</h1>
                    <p>Pacientes: correo o cédula. Personal del laboratorio: cédula asignada.</p>
                </header>

                <% if (registrado) { %>
                    <div class="alert alert-success" role="status">
                        <div class="d-flex"><div class="alert-icon"><i data-lucide="circle-check"></i></div><div><strong>Registro exitoso.</strong> Tu cuenta está lista.</div></div>
                    </div>
                <% } %>
                <% if (salida) { %>
                    <div class="alert alert-info" role="status">
                        <div class="d-flex"><div class="alert-icon"><i data-lucide="log-out"></i></div><div>Has cerrado sesión correctamente.</div></div>
                    </div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-danger" role="alert">
                        <div class="d-flex"><div class="alert-icon"><i data-lucide="circle-alert"></i></div><div><%= error %></div></div>
                    </div>
                <% } %>

                <form class="auth-form" method="post" action="/auth/login" novalidate>
                    <div>
                        <label class="form-label" for="identifier">Correo del paciente o cédula del personal</label>
                        <div class="input-icon">
                            <span class="input-icon-addon"><i data-lucide="user-round"></i></span>
                            <input id="identifier" class="form-control" type="text" name="identificador" value="<%= identificador %>" placeholder="correo@ejemplo.com o 0912345678" autocomplete="username" required autofocus>
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="password">Contraseña</label>
                        <div class="input-group auth-password">
                            <input id="password" class="form-control" type="password" name="password" placeholder="Ingresa tu contraseña" autocomplete="current-password" required>
                            <button class="btn btn-outline-secondary btn-icon" type="button" data-password-toggle aria-label="Mostrar contraseña" title="Mostrar contraseña"><i data-lucide="eye"></i></button>
                        </div>
                    </div>
                    <button class="btn btn-primary w-100" type="submit"><i data-lucide="log-in"></i>Ingresar a mi cuenta</button>
                    <div class="auth-links">
                        <span class="text-secondary">¿Aún no tienes una cuenta? <a href="/auth/registro">Regístrate aquí</a></span>
                        <a href="/"><i data-lucide="arrow-left" class="icon icon-sm me-1"></i>Volver al inicio</a>
                    </div>
                </form>
            </div>
        </section>
    </main>
    <%- include('../partials/scripts', { scripts: ['/js/auth.js'] }) %>
</body>
</html>
