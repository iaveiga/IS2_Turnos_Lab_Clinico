<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear cuenta | Clínica San Francisco</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="auth-page">
    <main class="auth-layout">
        <section class="auth-brand-panel" aria-label="Clínica San Francisco">
            <a class="brand brand-light" href="/" aria-label="Ir al inicio">
                <span class="brand-mark"><i data-lucide="flask-conical" aria-hidden="true"></i></span>
                <span class="brand-copy">
                    <strong>Clínica San Francisco</strong>
                    <small>Laboratorio clínico · Turnos</small>
                </span>
            </a>

            <div class="auth-message">
                <h1>Tu cuidado<br>comienza aquí.</h1>
                <p>Crea tu perfil de paciente para gestionar tus próximos turnos en un solo lugar.</p>
            </div>

            <p class="secure-note"><i data-lucide="shield-check" aria-hidden="true"></i> Portal exclusivo para pacientes</p>
        </section>

        <section class="auth-form-panel">
            <div class="register-shell">
                <% if (creado) { %>
                    <div class="success-state" role="status">
                        <span class="success-icon" aria-hidden="true"><i data-lucide="circle-check-big"></i></span>
                        <p class="eyebrow">REGISTRO COMPLETADO</p>
                        <h1>Tu cuenta está lista</h1>
                        <p>Ya puedes iniciar sesión con tu correo y contraseña.</p>
                        <a href="/auth/login" role="button">Iniciar sesión</a>
                        <a class="text-link" href="/">Volver al inicio</a>
                    </div>
                <% } else { %>
                    <header class="form-heading">
                        <p class="eyebrow">NUEVO PACIENTE</p>
                        <h1>Crea tu cuenta</h1>
                        <p>Completa tus datos personales para registrarte.</p>
                    </header>

                    <% if (errores.general) { %>
                        <div class="form-alert" role="alert"><%= errores.general %></div>
                    <% } %>

                    <form class="register-form" method="post" action="/auth/registro" novalidate>
                        <div class="form-grid">
                            <label>
                                Nombres
                                <input type="text" name="nombres" value="<%= datos.nombres %>" placeholder="Maria Elena" autocomplete="given-name" required aria-invalid="<%= errores.nombres ? 'true' : '' %>">
                                <% if (errores.nombres) { %><small class="field-error"><%= errores.nombres %></small><% } %>
                            </label>

                            <label>
                                Apellidos
                                <input type="text" name="apellidos" value="<%= datos.apellidos %>" placeholder="Gonzalez Perez" autocomplete="family-name" required aria-invalid="<%= errores.apellidos ? 'true' : '' %>">
                                <% if (errores.apellidos) { %><small class="field-error"><%= errores.apellidos %></small><% } %>
                            </label>

                            <label>
                                Cedula
                                <input type="text" name="identificacion" value="<%= datos.identificacion %>" placeholder="0012345678" inputmode="numeric" maxlength="10" autocomplete="off" required aria-invalid="<%= errores.identificacion ? 'true' : '' %>">
                                <% if (errores.identificacion) { %><small class="field-error"><%= errores.identificacion %></small><% } %>
                            </label>

                            <label>
                                Edad
                                <input type="number" name="edad" value="<%= datos.edad %>" placeholder="34" min="1" max="120" inputmode="numeric" required aria-invalid="<%= errores.edad ? 'true' : '' %>">
                                <% if (errores.edad) { %><small class="field-error"><%= errores.edad %></small><% } %>
                            </label>

                            <label>
                                Sexo
                                <select name="sexo" required aria-invalid="<%= errores.sexo ? 'true' : '' %>">
                                    <option value="" disabled <%= !datos.sexo ? 'selected' : '' %>>Seleccionar</option>
                                    <option value="FEMENINO" <%= datos.sexo === 'FEMENINO' ? 'selected' : '' %>>Femenino</option>
                                    <option value="MASCULINO" <%= datos.sexo === 'MASCULINO' ? 'selected' : '' %>>Masculino</option>
                                    <option value="OTRO" <%= datos.sexo === 'OTRO' ? 'selected' : '' %>>Otro</option>
                                    <option value="PREFIERO_NO_DECIR" <%= datos.sexo === 'PREFIERO_NO_DECIR' ? 'selected' : '' %>>Prefiero no decirlo</option>
                                </select>
                                <% if (errores.sexo) { %><small class="field-error"><%= errores.sexo %></small><% } %>
                            </label>

                            <label>
                                Celular / Telefono
                                <input type="tel" name="telefono" value="<%= datos.telefono %>" placeholder="099 123 4567" autocomplete="tel" required aria-invalid="<%= errores.telefono ? 'true' : '' %>">
                                <% if (errores.telefono) { %><small class="field-error"><%= errores.telefono %></small><% } %>
                            </label>
                        </div>

                        <label>
                            Correo electrónico
                            <input type="email" name="correo" value="<%= datos.correo %>" placeholder="nombre@correo.com" autocomplete="email" required aria-invalid="<%= errores.correo ? 'true' : '' %>">
                            <% if (errores.correo) { %><small class="field-error"><%= errores.correo %></small><% } %>
                        </label>

                        <label>
                            Contraseña
                            <span class="password-control">
                                <input id="password" type="password" name="password" placeholder="Minimo 8 caracteres" minlength="8" autocomplete="new-password" required aria-invalid="<%= errores.password ? 'true' : '' %>">
                                <button class="password-toggle" type="button" aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña"></button>
                            </span>
                            <% if (errores.password) { %><small class="field-error"><%= errores.password %></small><% } %>
                        </label>

                        <button class="primary-action" type="submit">Registrarme</button>
                        <a class="text-link" href="/auth/login">Volver a iniciar sesión</a>
                    </form>
                <% } %>
            </div>
        </section>
    </main>
    <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
    <script>lucide.createIcons();</script>
    <script src="/js/register.js" defer></script>
</body>
</html>
