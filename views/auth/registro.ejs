<%- include('../partials/head', {
    titulo: 'Crear cuenta',
    descripcion: 'Registro de pacientes del Laboratorio Clínico San Francisco.'
}) %>
<body class="auth-page">
    <main class="auth-layout">
        <section class="auth-visual" aria-label="Clínica San Francisco">
            <a class="auth-brand" href="/" aria-label="Ir al inicio">
                <span class="app-brand-mark">CSF</span>
                <span class="app-brand-copy">
                    <strong>Clínica San Francisco</strong>
                    <small>Laboratorio clínico</small>
                </span>
            </a>
            <div class="auth-message">
                <h1>Tu cuidado comienza aquí.</h1>
                <p>Crea tu perfil de paciente para organizar tus próximos turnos en un solo lugar.</p>
            </div>
            <p class="auth-security"><i data-lucide="shield-check"></i>Registro exclusivo para pacientes</p>
        </section>

        <section class="auth-form-panel">
            <div class="auth-shell">
                <% if (creado) { %>
                    <div class="auth-success" role="status">
                        <span class="avatar bg-green-lt text-green"><i data-lucide="circle-check-big"></i></span>
                        <p class="app-eyebrow">Registro completado</p>
                        <h1>Tu cuenta está lista</h1>
                        <p>Ya puedes iniciar sesión con tu correo o cédula y contraseña.</p>
                        <a class="btn btn-primary" href="/auth/login"><i data-lucide="log-in"></i>Iniciar sesión</a>
                        <div class="auth-links"><a href="/">Volver al inicio</a></div>
                    </div>
                <% } else { %>
                    <header class="auth-heading">
                        <p class="app-eyebrow">Nuevo paciente</p>
                        <h1>Crea tu cuenta</h1>
                        <p>Completa tus datos personales para registrarte.</p>
                    </header>

                    <% if (errores.general) { %>
                        <div class="alert alert-danger" role="alert">
                            <div class="d-flex"><div class="alert-icon"><i data-lucide="circle-alert"></i></div><div><%= errores.general %></div></div>
                        </div>
                    <% } %>

                    <form class="auth-form" method="post" action="/auth/registro" novalidate>
                        <div class="auth-form-grid">
                            <div>
                                <label class="form-label" for="first-name">Nombres</label>
                                <input id="first-name" class="form-control <%= errores.nombres ? 'is-invalid' : '' %>" type="text" name="nombres" value="<%= datos.nombres %>" placeholder="María Elena" autocomplete="given-name" required>
                                <% if (errores.nombres) { %><small class="field-error"><%= errores.nombres %></small><% } %>
                            </div>
                            <div>
                                <label class="form-label" for="last-name">Apellidos</label>
                                <input id="last-name" class="form-control <%= errores.apellidos ? 'is-invalid' : '' %>" type="text" name="apellidos" value="<%= datos.apellidos %>" placeholder="González Pérez" autocomplete="family-name" required>
                                <% if (errores.apellidos) { %><small class="field-error"><%= errores.apellidos %></small><% } %>
                            </div>
                            <div>
                                <label class="form-label" for="identification">Cédula</label>
                                <input id="identification" class="form-control <%= errores.identificacion ? 'is-invalid' : '' %>" type="text" name="identificacion" value="<%= datos.identificacion %>" placeholder="0912345678" inputmode="numeric" maxlength="10" autocomplete="off" required>
                                <% if (errores.identificacion) { %><small class="field-error"><%= errores.identificacion %></small><% } %>
                            </div>
                            <div>
                                <label class="form-label" for="age">Edad</label>
                                <input id="age" class="form-control <%= errores.edad ? 'is-invalid' : '' %>" type="number" name="edad" value="<%= datos.edad %>" placeholder="34" min="1" max="120" inputmode="numeric" required>
                                <% if (errores.edad) { %><small class="field-error"><%= errores.edad %></small><% } %>
                            </div>
                            <div>
                                <label class="form-label" for="sex">Sexo</label>
                                <select id="sex" class="form-select <%= errores.sexo ? 'is-invalid' : '' %>" name="sexo" required>
                                    <option value="" disabled <%= !datos.sexo ? 'selected' : '' %>>Seleccionar</option>
                                    <option value="FEMENINO" <%= datos.sexo === 'FEMENINO' ? 'selected' : '' %>>Femenino</option>
                                    <option value="MASCULINO" <%= datos.sexo === 'MASCULINO' ? 'selected' : '' %>>Masculino</option>
                                    <option value="OTRO" <%= datos.sexo === 'OTRO' ? 'selected' : '' %>>Otro</option>
                                    <option value="PREFIERO_NO_DECIR" <%= datos.sexo === 'PREFIERO_NO_DECIR' ? 'selected' : '' %>>Prefiero no decirlo</option>
                                </select>
                                <% if (errores.sexo) { %><small class="field-error"><%= errores.sexo %></small><% } %>
                            </div>
                            <div>
                                <label class="form-label" for="phone">Celular / teléfono</label>
                                <input id="phone" class="form-control <%= errores.telefono ? 'is-invalid' : '' %>" type="tel" name="telefono" value="<%= datos.telefono %>" placeholder="099 123 4567" autocomplete="tel" required>
                                <% if (errores.telefono) { %><small class="field-error"><%= errores.telefono %></small><% } %>
                            </div>
                        </div>
                        <div>
                            <label class="form-label" for="email">Correo electrónico</label>
                            <input id="email" class="form-control <%= errores.correo ? 'is-invalid' : '' %>" type="email" name="correo" value="<%= datos.correo %>" placeholder="nombre@correo.com" autocomplete="email" required>
                            <% if (errores.correo) { %><small class="field-error"><%= errores.correo %></small><% } %>
                        </div>
                        <div>
                            <label class="form-label" for="password">Contraseña</label>
                            <div class="input-group auth-password">
                                <input id="password" class="form-control <%= errores.password ? 'is-invalid' : '' %>" type="password" name="password" placeholder="Mínimo 8 caracteres" minlength="8" autocomplete="new-password" required>
                                <button class="btn btn-outline-secondary btn-icon" type="button" data-password-toggle aria-label="Mostrar contraseña" title="Mostrar contraseña"><i data-lucide="eye"></i></button>
                            </div>
                            <% if (errores.password) { %><small class="field-error"><%= errores.password %></small><% } %>
                        </div>
                        <button class="btn btn-primary w-100" type="submit"><i data-lucide="user-plus"></i>Crear mi cuenta</button>
                        <div class="auth-links"><span class="text-secondary">¿Ya tienes una cuenta? <a href="/auth/login">Inicia sesión</a></span></div>
                    </form>
                <% } %>
            </div>
        </section>
    </main>
    <%- include('../partials/scripts', { scripts: ['/js/auth.js'] }) %>
</body>
</html>
