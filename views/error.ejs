<%- include('partials/head', {
    titulo: 'Acceso restringido',
    descripcion: 'Aviso del portal del Laboratorio Clínico San Francisco.'
}) %>
<body class="error-page">
    <main class="card error-shell">
        <div class="card-body p-4 p-md-5">
            <span class="avatar bg-red-lt text-red"><i data-lucide="shield-alert"></i></span>
            <h1>Acceso restringido</h1>
            <p><%= locals.mensaje || 'No tienes permisos para acceder a esta sección o la página no existe.' %></p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a class="btn btn-primary" href="/"><i data-lucide="house"></i>Ir al inicio</a>
                <a class="btn btn-outline-secondary" href="/auth/login"><i data-lucide="log-in"></i>Iniciar sesión</a>
            </div>
        </div>
    </main>
    <%- include('partials/scripts') %>
</body>
</html>
