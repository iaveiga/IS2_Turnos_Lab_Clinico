<%- include('partials/head', {
    titulo: 'Laboratorio clínico',
    descripcion: 'Agenda tus turnos de laboratorio en Clínica San Francisco.'
}) %>
<body class="app-page">
    <%- include('partials/public-header', { seccion: 'inicio' }) %>

    <main>
        <section class="home-hero" aria-labelledby="home-title">
            <img class="home-hero-photo" src="/images/laboratorio-hero.png" alt="Profesional del laboratorio de Clínica San Francisco">
            <div class="home-hero-shade" aria-hidden="true"></div>
            <div class="container-xl home-hero-inner">
                <div class="home-hero-copy">
                    <p class="app-eyebrow">Tu salud, nuestra prioridad</p>
                    <h1 id="home-title">Resultados confiables para una vida más saludable</h1>
                    <p>Agenda tus turnos de laboratorio en línea de forma rápida, segura y desde cualquier lugar.</p>
                    <div class="home-hero-actions">
                        <% if (locals.usuario && ((locals.usuario.roles || []).includes('PACIENTE') || locals.usuario.rol === 'PACIENTE')) { %>
                            <a class="btn btn-primary" href="/turnos/nuevo"><i data-lucide="calendar-plus"></i>Agendar mi turno</a>
                            <a class="btn btn-outline-light" href="/turnos"><i data-lucide="calendar-days"></i>Ver mis citas</a>
                        <% } else if (locals.usuario) { %>
                            <a class="btn btn-primary" href="/admin/usuarios"><i data-lucide="shield-check"></i>Ir a administración</a>
                        <% } else { %>
                            <a class="btn btn-primary" href="/auth/registro"><i data-lucide="calendar-plus"></i>Agendar mi turno</a>
                            <a class="btn btn-outline-light" href="/auth/login"><i data-lucide="log-in"></i>Iniciar sesión</a>
                        <% } %>
                    </div>
                    <div class="home-benefits" aria-label="Beneficios">
                        <span><i data-lucide="shield-check"></i><strong>Seguro</strong><small>y confidencial</small></span>
                        <span><i data-lucide="clock-3"></i><strong>Rápido</strong><small>y sencillo</small></span>
                        <span><i data-lucide="heart-pulse"></i><strong>Profesional</strong><small>y confiable</small></span>
                    </div>
                </div>

                <aside class="hero-service-list" aria-label="Servicios disponibles">
                    <h2>Servicios del laboratorio</h2>
                    <ul>
                        <li><i data-lucide="droplets"></i>Exámenes de sangre y hematología</li>
                        <li><i data-lucide="scan-heart"></i>VIH e inmunología</li>
                        <li><i data-lucide="test-tube"></i>Orina y coproanálisis</li>
                        <li><i data-lucide="scan-search"></i>Pruebas de alergias</li>
                    </ul>
                </aside>
            </div>
        </section>

        <section class="content-band" aria-labelledby="services-title">
            <div class="container-xl">
                <div class="section-heading text-center">
                    <p class="app-eyebrow">Nuestros servicios</p>
                    <h2 id="services-title">Análisis para cuidar de ti</h2>
                    <p>Exámenes realizados por personal especializado y con procesos clínicos seguros.</p>
                </div>
                <div class="service-card-grid">
                    <article class="service-summary-card">
                        <span class="service-summary-icon"><i data-lucide="droplets"></i></span>
                        <h3>Exámenes de sangre</h3>
                        <p>Perfil lipídico, glucosa, hemograma y análisis complementarios.</p>
                    </article>
                    <article class="service-summary-card">
                        <span class="service-summary-icon"><i data-lucide="scan-heart"></i></span>
                        <h3>VIH e inmunología</h3>
                        <p>Serología, pruebas rápidas y procedimientos confirmatorios.</p>
                    </article>
                    <article class="service-summary-card">
                        <span class="service-summary-icon"><i data-lucide="test-tube"></i></span>
                        <h3>Orina y coproanálisis</h3>
                        <p>Análisis generales, cultivos y estudios específicos.</p>
                    </article>
                    <article class="service-summary-card">
                        <span class="service-summary-icon"><i data-lucide="scan-search"></i></span>
                        <h3>Pruebas de alergias</h3>
                        <p>Paneles de alérgenos ambientales y alimentarios.</p>
                    </article>
                </div>
                <div class="text-center mt-4">
                    <a class="btn btn-outline-primary" href="/servicios">Consultar catálogo completo<i data-lucide="arrow-right"></i></a>
                </div>
            </div>
        </section>

        <section class="content-band content-band-muted" aria-labelledby="process-title">
            <div class="container-xl process-grid">
                <div>
                    <div class="section-heading">
                        <p class="app-eyebrow">Simple y rápido</p>
                        <h2 id="process-title">Agenda en cuatro pasos</h2>
                        <p>Gestiona tu atención sin llamadas ni esperas innecesarias.</p>
                    </div>
                    <ol class="process-steps">
                        <li><span class="process-number">1</span><strong>Regístrate</strong><small>Crea tu perfil de paciente.</small></li>
                        <li><span class="process-number">2</span><strong>Selecciona</strong><small>Elige el examen requerido.</small></li>
                        <li><span class="process-number">3</span><strong>Agenda</strong><small>Escoge una fecha y hora.</small></li>
                        <li><span class="process-number">4</span><strong>Confirma</strong><small>Recibe tu código de turno.</small></li>
                    </ol>
                </div>
                <article class="process-feature">
                    <img src="/images/laboratorio-hero.png" alt="Equipos y muestras del laboratorio clínico">
                    <div>
                        <h3>Resultados con respaldo profesional</h3>
                        <p>Contamos con tecnología actual y un equipo especializado para brindar resultados precisos y confiables.</p>
                    </div>
                </article>
            </div>
        </section>

        <section class="trust-band" aria-label="Compromisos del laboratorio">
            <div class="container-xl trust-grid">
                <div><i data-lucide="users-round"></i><strong>Personal certificado</strong><small>Atención especializada</small></div>
                <div><i data-lucide="shield-check"></i><strong>Procesos seguros</strong><small>Protección de tus datos</small></div>
                <div><i data-lucide="badge-check"></i><strong>Resultados confiables</strong><small>Control de calidad</small></div>
                <div><i data-lucide="map-pin"></i><strong>Acceso sencillo</strong><small>Gestión desde cualquier lugar</small></div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
</body>
</html>
